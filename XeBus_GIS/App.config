<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- CSDL PostgreSQL/PostGIS. SearchPath: ưu tiên schema xebus của dự án -->
        <add name="CSDLKG"
             connectionString="Host=localhost;Port=5432;Database=CSDLKG;Username=postgres;Password=<MAT_KHAU_POSTGRES>;Search Path=xebus,public;Timeout=15;Command Timeout=120"
             providerName="Npgsql" />
    </connectionStrings>
    <appSettings>
        <!-- Thư mục chứa pg_dump.exe (chức năng Sao lưu – Quản trị) -->
        <add key="PgBinPath" value="C:\Program Files\PostgreSQL\17\bin" />
        <!-- Thư mục lưu file sao lưu -->
        <add key="BackupFolder" value="D:\XeBus_GIS\database\backup" />
        <!-- Bán kính phục vụ mặc định của trạm (m) -->
        <add key="BanKinhPhucVu" value="500" />
        <!-- Nền bản đồ: OSM (mặc định, kiểu HOT qua máy chủ tile cục bộ) | OSMChuan (kiểu OSM chuẩn, màu gốc) | OpenStreetMap (nhà cung cấp có sẵn của MapWinGIS – thường không tải được) | None -->
        <add key="NenBanDo" value="OSM" />
    </appSettings>
</configuration>
