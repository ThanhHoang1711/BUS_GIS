<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- CSDL PostgreSQL/PostGIS. SearchPath: ưu tiên schema xebus của dự án.
             KHÔNG ghi mật khẩu thật ở đây (file này nằm trong repo public): chép App.local.config.example
             thành App.local.config (đã .gitignore) rồi điền mật khẩu – app đọc file đó trước (Data/CauHinh.cs). -->
        <add name="CSDLKG"
             connectionString="Host=localhost;Port=5432;Database=CSDLKG;Username=postgres;Password=MAT_KHAU_POSTGRES;Search Path=xebus,public;Timeout=15;Command Timeout=120"
             providerName="Npgsql" />
    </connectionStrings>
    <appSettings>
        <!-- Thư mục chứa pg_dump.exe (chức năng Sao lưu – Quản trị) -->
        <add key="PgBinPath" value="C:\Program Files\PostgreSQL\17\bin" />
        <!-- Thư mục lưu file sao lưu -->
        <add key="BackupFolder" value="D:\XeBus_GIS\database\backup" />
        <!-- Bán kính phục vụ mặc định của trạm (m) -->
        <add key="BanKinhPhucVu" value="500" />
        <!-- Nền bản đồ: EsriXam (mặc định – Esri World Light Gray, ít chi tiết) | EsriPho (Esri World Street Map) | OSM (kiểu HOT làm nhạt) | OSMChuan | None. Người dùng đổi được ở tab "Lớp &amp; chú giải" (lưu %LOCALAPPDATA%\XeBus_GIS\nen.txt) -->
        <add key="NenBanDo" value="EsriXam" />
    </appSettings>
</configuration>
